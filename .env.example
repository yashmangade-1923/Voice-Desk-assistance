# Jenny Desktop Voice Assistant - Environment Configuration

# Optional Google Gemini API key for open-ended conversational AI reasoning
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Push-to-Talk Hotkey (default: ctrl+shift+a)
PUSH_TO_TALK_HOTKEY=ctrl+shift+a

# Voice preferences: 'zira' (female, recommended for Jenny) or 'david' (male)
VOICE_PREFERENCE=zira
VOICE_RATE=185
VOICE_VOLUME=1.0

# Microphone Sensitivity / Threshold
STT_ENERGY_THRESHOLD=300
STT_PHRASE_TIME_LIMIT=8.0
